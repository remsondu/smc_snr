void DrawSnRLevels() {
    if(!InpShowSnR) return;

    int cnt = MathMax(1, MathMin(SNR_MAX_LEVELS, InpSnRLevelCount));
    datetime rightT = iTime(_Symbol, _Period, 0) + PeriodSeconds(_Period) * 10;
    ENUM_LINE_STYLE st = LineStyle(InpSnRLineStyle);
    int w = MathMax(1, InpSnRLineWidth);

    for(int i = 0; i < SNR_MAX_LEVELS; i++) {
        string rl = OBJ_PREFIX + "snrR_"  + IntegerToString(i + 1);
        string rt = OBJ_PREFIX + "snrRT_" + IntegerToString(i + 1);
        string sl = OBJ_PREFIX + "snrS_"  + IntegerToString(i + 1);
        string sTx= OBJ_PREFIX + "snrST_" + IntegerToString(i + 1);

        if(i < cnt && i < ArraySize(g_res)) {
            DrawTrend(rl, g_res[i].time, g_res[i].price, rightT, g_res[i].price,
                      ResolveResist(), st, w, InpSnRExtendRight);
            if(InpSnRShowPrice)
                DrawText(rt, rightT, g_res[i].price,
                         "R" + IntegerToString(i + 1) + " -> " + DoubleToString(g_res[i].price, _Digits),
                         ResolveResist(), 8, ANCHOR_LEFT);
            else SafeDelete(rt);
        } else { SafeDelete(rl); SafeDelete(rt); }

        if(i < cnt && i < ArraySize(g_sup)) {
            DrawTrend(sl, g_sup[i].time, g_sup[i].price, rightT, g_sup[i].price,
                      ResolveSupport(), st, w, InpSnRExtendRight);
            if(InpSnRShowPrice)
                DrawText(sTx, rightT, g_sup[i].price,
                         "S" + IntegerToString(i + 1) + " -> " + DoubleToString(g_sup[i].price, _Digits),
                         ResolveSupport(), 8, ANCHOR_LEFT);
            else SafeDelete(sTx);
        } else { SafeDelete(sl); SafeDelete(sTx); }
    }
}

void DrawTrendlinesOnChart() {
    if(!InpShowTrendlines) {
        SafeDelete(OBJ_PREFIX + "tlUp");   SafeDelete(OBJ_PREFIX + "tlUpTxt");
        SafeDelete(OBJ_PREFIX + "tlLo");   SafeDelete(OBJ_PREFIX + "tlLoTxt");
        return;
    }

    datetime nowT   = iTime(_Symbol, _Period, 0);
    datetime rightT = InpTLExtendToNow ? nowT : nowT;
    datetime labelT = nowT + PeriodSeconds(_Period) * 10;
    ENUM_LINE_STYLE st = LineStyle(InpTLStyle);
    int w = MathMax(1, InpTLWidth);

    if(g_upperTL.valid) {
        double proj = TLValueAt(g_upperTL, rightT);
        DrawTrend(OBJ_PREFIX + "tlUp", g_upperTL.t1, g_upperTL.p1, rightT, proj,
                  InpTLColor, st, w, false);
        if(InpTLShowPrice)
            DrawText(OBJ_PREFIX + "tlUpTxt", labelT, TLValueAt(g_upperTL, labelT),
                     "Upper -> " + DoubleToString(TLValueAt(g_upperTL, nowT), _Digits),
                     ResolveResist(), 8, ANCHOR_LEFT);
        else SafeDelete(OBJ_PREFIX + "tlUpTxt");
    }

    if(g_lowerTL.valid) {
        double proj = TLValueAt(g_lowerTL, rightT);
        DrawTrend(OBJ_PREFIX + "tlLo", g_lowerTL.t1, g_lowerTL.p1, rightT, proj,
                  InpTLColor, st, w, false);
