void DrawSnRDashboard() {
    if(!InpShowDashboard) {
        for(int i = 0; i < DASH_MAX_LINES; i++) SafeDelete(OBJ_PREFIX + "dash_" + IntegerToString(i));
        return;
    }

    int row = 0;
    color hdr = clrSilver;

    string biasTxt = (g_swingTrend.bias == BULLISH) ? "BULL"
                   : (g_swingTrend.bias == BEARISH) ? "BEAR" : "FLAT";
    DashLine(row++, "SMC  " + _Symbol + "  " + EnumToString((ENUM_TIMEFRAMES)_Period)
                    + "   swing bias: " + biasTxt, hdr);

    if(InpShowSnR) {
        int cnt = MathMax(1, MathMin(SNR_MAX_LEVELS, InpSnRLevelCount));
        for(int i = 0; i < cnt && row < DASH_MAX_LINES - 3; i++) {
            string s = (i < ArraySize(g_sup)) ? DoubleToString(g_sup[i].price, _Digits) : "-";
            string r = (i < ArraySize(g_res)) ? DoubleToString(g_res[i].price, _Digits) : "-";
            DashLine(row++, "S" + IntegerToString(i + 1) + " " + s
                          + "   R" + IntegerToString(i + 1) + " " + r, hdr);
        }
    }

    if(InpShowTrendlines && row < DASH_MAX_LINES - 1) {
        datetime nowT = iTime(_Symbol, _Period, 0);
        string up = g_upperTL.valid ? DoubleToString(TLValueAt(g_upperTL, nowT), _Digits) : "-";
        string lo = g_lowerTL.valid ? DoubleToString(TLValueAt(g_lowerTL, nowT), _Digits) : "-";
        DashLine(row++, "TL upper " + up, ResolveResist());
        DashLine(row++, "TL lower " + lo, ResolveSupport());
    }

    for(int i = row; i < DASH_MAX_LINES; i++) SafeDelete(OBJ_PREFIX + "dash_" + IntegerToString(i));
}

