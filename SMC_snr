            DrawText(OBJ_PREFIX + "tlLoTxt", labelT, TLValueAt(g_lowerTL, labelT),
                     "Lower -> " + DoubleToString(TLValueAt(g_lowerTL, nowT), _Digits),
                     ResolveSupport(), 8, ANCHOR_LEFT);
        else SafeDelete(OBJ_PREFIX + "tlLoTxt");
    }
}

