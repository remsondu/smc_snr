    if(h > g_trailing.top) {
        g_trailing.top         = h;
        g_trailing.lastTopTime = T(0);
    }
    if(l < g_trailing.bottom) {
        g_trailing.bottom         = l;
        g_trailing.lastBottomTime = T(0);
