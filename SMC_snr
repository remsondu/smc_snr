//===================== ORDER BLOCKS =================================
void PushOB(OrderBlockRec &arr[], OrderBlockRec &ob) {
    int n = ArraySize(arr);
    ArrayResize(arr, n + 1);
    for(int i = n; i > 0; i--) arr[i] = arr[i - 1];
    arr[0] = ob;
    if(ArraySize(arr) > 100) ArrayResize(arr, 100);
}

void StoreOrderBlock(Pivot &p, bool internalChannel, int bias) {
    if(!internalChannel && !InpShowSwingOBs) return;
    if(internalChannel  && !InpShowInternalOBs) return;

    int pivotShiftMQL = iBarShift(_Symbol, _Period, p.barTime, false);
    if(pivotShiftMQL <= 0) return;
    int pivotOff = pivotShiftMQL - 1 - g_scanShift;
    if(pivotOff < 1) return;

    int extremeOff = pivotOff;
    double extremeVal = (bias == BEARISH) ? -DBL_MAX : DBL_MAX;

    for(int off = pivotOff; off >= 1; off--) {
        if(bias == BEARISH) {
            double ph = GetParsedHigh(off);
            if(ph > extremeVal) { extremeVal = ph; extremeOff = off; }
        } else {
            double pl = GetParsedLow(off);
            if(pl < extremeVal) { extremeVal = pl; extremeOff = off; }
        }
    }

    OrderBlockRec ob;
    ob.obHigh = GetParsedHigh(extremeOff);
    ob.obLow  = GetParsedLow(extremeOff);
    ob.obTime = T(extremeOff);
    ob.bias   = bias;
    g_objCounter++;
    ob.objId  = g_objCounter;
    ob.active = true;

    if(internalChannel) PushOB(g_internalOBs, ob);
    else                PushOB(g_swingOBs,    ob);
}

void RemoveOBAt(OrderBlockRec &arr[], int idx) {
    int n = ArraySize(arr);
    if(idx < 0 || idx >= n) return;
    SafeDelete(OBJ_PREFIX + "ob_" + IntegerToString(arr[idx].objId));
    for(int i = idx; i < n - 1; i++) arr[i] = arr[i + 1];
    ArrayResize(arr, n - 1);
}

void DeleteOrderBlocks(bool internalChannel) {
    int n = internalChannel ? ArraySize(g_internalOBs) : ArraySize(g_swingOBs);

    double bullSrc = (InpOBMitigation == SMC_BY_CLOSE) ? C_(0) : L(0);
    double bearSrc = (InpOBMitigation == SMC_BY_CLOSE) ? C_(0) : H(0);

    for(int i = n - 1; i >= 0; i--) {
        OrderBlockRec ob;
        if(internalChannel) ob = g_internalOBs[i];
        else                ob = g_swingOBs[i];

        bool crossed = false;
        if(ob.bias == BEARISH && bearSrc > ob.obHigh) {
            crossed = true;
            if(internalChannel) g_alerts.internalBearishOB = true;
            else                g_alerts.swingBearishOB    = true;
        } else if(ob.bias == BULLISH && bullSrc < ob.obLow) {
            crossed = true;
            if(internalChannel) g_alerts.internalBullishOB = true;
            else                g_alerts.swingBullishOB    = true;
        }
        if(crossed) {
            if(internalChannel) RemoveOBAt(g_internalOBs, i);
            else                RemoveOBAt(g_swingOBs, i);
        }
    }
}

void DrawOrderBlocks(bool internalChannel) {
    int maxCount = internalChannel ? InpInternalOBCount : InpSwingOBCount;
    if(maxCount <= 0) return;

    int n;
    if(internalChannel) n = ArraySize(g_internalOBs);
    else                n = ArraySize(g_swingOBs);
    int show = MathMin(maxCount, n);
    datetime rightEdge = T(0) + PeriodSeconds(_Period) * 50;

    for(int i = 0; i < show; i++) {
        OrderBlockRec ob;
        if(internalChannel) ob = g_internalOBs[i];
        else                ob = g_swingOBs[i];

        color fill;
        if(InpStyle == SMC_MONOCHROME) {
            fill = (ob.bias == BEARISH) ? C'120,123,134' : C'200,203,212';
        } else {
            if(internalChannel) fill = (ob.bias == BEARISH) ? InpInternalBearOBColor : InpInternalBullOBColor;
            else                fill = (ob.bias == BEARISH) ? InpSwingBearOBColor    : InpSwingBullOBColor;
        }
        color border = fill;   // v1.11 fix

        string name = OBJ_PREFIX + "ob_" + IntegerToString(ob.objId);
        DrawRect(name, ob.obTime, ob.obHigh, rightEdge, ob.obLow, border, fill, true);
    }
}

//===================== DISPLAY STRUCTURE (BOS/CHoCH) ================
void DisplayStructure(bool internalChannel) {
    bool bullishBar = true, bearishBar = true;
    if(InpInternalConfluence && internalChannel) {
        double h = H(0), l = L(0), c = C_(0), o = O_(0);
        bullishBar = (h - MathMax(c, o)) > (MathMin(c, o) - l);
        bearishBar = (h - MathMax(c, o)) < (MathMin(c, o) - l);
    }

    Pivot ph; TrendBias tb;
    if(internalChannel) { ph = g_internalHigh; tb = g_internalTrend; }
    else                { ph = g_swingHigh;    tb = g_swingTrend;    }

    bool extraBull = internalChannel
        ? (g_internalHigh.currentLevel != g_swingHigh.currentLevel && bullishBar)
        : true;

    double curC = C_(0), prevC = C_(1);
    if(curC > ph.currentLevel && prevC <= ph.currentLevel && !ph.crossed && extraBull
       && ph.currentLevel != 0.0) {

        string tag = (tb.bias == BEARISH) ? LBL_TAG_CHOCH : LBL_TAG_BOS;

        if(internalChannel) {
            if(tag == LBL_TAG_CHOCH) g_alerts.internalBullishCHoCH = true;
            else                     g_alerts.internalBullishBOS   = true;
        } else {
            if(tag == LBL_TAG_CHOCH) g_alerts.swingBullishCHoCH = true;
            else                     g_alerts.swingBullishBOS   = true;
        }

        if(internalChannel) { g_internalHigh.crossed = true; g_internalTrend.bias = BULLISH; }
        else                { g_swingHigh.crossed    = true; g_swingTrend.bias    = BULLISH; }

        bool show;
        ENUM_SMC_STRUCT_DISPLAY filt;
        if(internalChannel) { show = InpShowInternals;  filt = InpShowInternalBull; }
        else                { show = InpShowStructure;  filt = InpShowSwingBull;    }

        bool passFilter = (filt == SMC_ALL)
                        || (filt == SMC_BOS_ONLY  && tag != LBL_TAG_CHOCH)
                        || (filt == SMC_CHOCH_ONLY && tag == LBL_TAG_CHOCH);

        if(show && passFilter) {
            color c = internalChannel ? ResolveInternalBull() : ResolveSwingBull();
            ENUM_LINE_STYLE st = internalChannel ? STYLE_DASH : STYLE_SOLID;
            ENUM_SMC_LABEL_SIZE sz = internalChannel ? InpInternalLabelSize : InpSwingLabelSize;
            Pivot phCopy = ph;
            DrawStructure(phCopy, tag, c, st, sz, false, internalChannel, false);
        }

        if((internalChannel && InpShowInternalOBs) || (!internalChannel && InpShowSwingOBs)) {
            Pivot phCopy = ph;
            StoreOrderBlock(phCopy, internalChannel, BULLISH);
        }
    }

    Pivot pl;
    if(internalChannel) { pl = g_internalLow; tb = g_internalTrend; }
    else                { pl = g_swingLow;    tb = g_swingTrend;    }

    bool extraBear = internalChannel
        ? (g_internalLow.currentLevel != g_swingLow.currentLevel && bearishBar)
        : true;

    if(curC < pl.currentLevel && prevC >= pl.currentLevel && !pl.crossed && extraBear
       && pl.currentLevel != 0.0) {

        string tag = (tb.bias == BULLISH) ? LBL_TAG_CHOCH : LBL_TAG_BOS;

        if(internalChannel) {
            if(tag == LBL_TAG_CHOCH) g_alerts.internalBearishCHoCH = true;
            else                     g_alerts.internalBearishBOS   = true;
        } else {
            if(tag == LBL_TAG_CHOCH) g_alerts.swingBearishCHoCH = true;
            else                     g_alerts.swingBearishBOS   = true;
        }

        if(internalChannel) { g_internalLow.crossed = true; g_internalTrend.bias = BEARISH; }
        else                { g_swingLow.crossed    = true; g_swingTrend.bias    = BEARISH; }

        bool show;
        ENUM_SMC_STRUCT_DISPLAY filt;
        if(internalChannel) { show = InpShowInternals;  filt = InpShowInternalBear; }
        else                { show = InpShowStructure;  filt = InpShowSwingBear;    }

        bool passFilter = (filt == SMC_ALL)
                        || (filt == SMC_BOS_ONLY  && tag != LBL_TAG_CHOCH)
                        || (filt == SMC_CHOCH_ONLY && tag == LBL_TAG_CHOCH);

        if(show && passFilter) {
            color c = internalChannel ? ResolveInternalBear() : ResolveSwingBear();
            ENUM_LINE_STYLE st = internalChannel ? STYLE_DASH : STYLE_SOLID;
            ENUM_SMC_LABEL_SIZE sz = internalChannel ? InpInternalLabelSize : InpSwingLabelSize;
            Pivot plCopy = pl;
            DrawStructure(plCopy, tag, c, st, sz, true, internalChannel, true);
        }

        if((internalChannel && InpShowInternalOBs) || (!internalChannel && InpShowSwingOBs)) {
            Pivot plCopy = pl;
            StoreOrderBlock(plCopy, internalChannel, BEARISH);
        }
    }
}

//===================== FAIR VALUE GAPS ==============================
void DeleteFairValueGaps() {
    double curH = H(0), curL = L(0);
    for(int i = ArraySize(g_fvgs) - 1; i >= 0; i--) {
        bool kill = false;
        if(g_fvgs[i].bias == BULLISH && curL < g_fvgs[i].bottom) kill = true;
        if(g_fvgs[i].bias == BEARISH && curH > g_fvgs[i].top)    kill = true;
        if(kill) {
            SafeDelete(OBJ_PREFIX + "fvgT_" + IntegerToString(g_fvgs[i].objId));
            SafeDelete(OBJ_PREFIX + "fvgB_" + IntegerToString(g_fvgs[i].objId));
            for(int j = i; j < ArraySize(g_fvgs) - 1; j++) g_fvgs[j] = g_fvgs[j + 1];
            ArrayResize(g_fvgs, ArraySize(g_fvgs) - 1);
        }
    }
}

void DrawFairValueGaps() {
    ENUM_TIMEFRAMES tf = InpFVGTimeframe == PERIOD_CURRENT ? _Period : InpFVGTimeframe;

    bool isChartTF = (tf == _Period);
    if(!isChartTF && g_scanShift > 0) return;

    if(tf != _Period) {
        datetime cur = iTime(_Symbol, tf, 0);
        static datetime lastFvgTfBar = 0;
        if(cur == lastFvgTfBar) return;
        lastFvgTfBar = cur;
    }

    int extra = isChartTF ? g_scanShift : 0;

    double last2H  = iHigh (_Symbol, tf, 3 + extra);
    double last2L  = iLow  (_Symbol, tf, 3 + extra);
    double lastC   = iClose(_Symbol, tf, 2 + extra);
    double lastO   = iOpen (_Symbol, tf, 2 + extra);
    datetime lastT = iTime (_Symbol, tf, 2 + extra);
    double curH    = iHigh (_Symbol, tf, 1 + extra);
    double curL    = iLow  (_Symbol, tf, 1 + extra);
    datetime curT  = iTime (_Symbol, tf, 1 + extra);

    if(lastO == 0 || last2H == 0) return;

    double barDeltaPct = (lastC - lastO) / (lastO * 100.0);
    double threshold = 0.0;
    if(InpFVGAutoThresh) {
        static double cumAbsDelta = 0.0;
        static int cumCount = 0;
        cumAbsDelta += MathAbs(barDeltaPct);
        cumCount++;
        threshold = (cumCount > 0) ? (cumAbsDelta / cumCount) * 2.0 : 0.0;
    }

    bool bullFVG = (curL > last2H) && (lastC > last2H) && (barDeltaPct >  threshold);
    bool bearFVG = (curH < last2L) && (lastC < last2L) && (-barDeltaPct > threshold);

    datetime rightT = curT + (int)((curT - lastT) * (InpFVGExtend + 1));

    if(bullFVG) {
        g_alerts.bullishFVG = true;
        FVGRec rec;
        rec.top = curL; rec.bottom = last2H; rec.bias = BULLISH; rec.active = true;
        rec.createdAt = curT;
        g_objCounter++;
        rec.objId = g_objCounter;
        color c = ResolveFVGBull();
        double mid = (curL + last2H) / 2.0;
        DrawRect(OBJ_PREFIX + "fvgT_" + IntegerToString(rec.objId), lastT, curL,  rightT, mid,    c, c, true);
        DrawRect(OBJ_PREFIX + "fvgB_" + IntegerToString(rec.objId), lastT, mid,   rightT, last2H, c, c, true);
        int n = ArraySize(g_fvgs);
        ArrayResize(g_fvgs, n + 1);
        for(int i = n; i > 0; i--) g_fvgs[i] = g_fvgs[i - 1];
        g_fvgs[0] = rec;
    }
    if(bearFVG) {
        g_alerts.bearishFVG = true;
        FVGRec rec;
        rec.top = curH; rec.bottom = last2L; rec.bias = BEARISH; rec.active = true;
        rec.createdAt = curT;
        g_objCounter++;
        rec.objId = g_objCounter;
        color c = ResolveFVGBear();
        double mid = (curH + last2L) / 2.0;
        DrawRect(OBJ_PREFIX + "fvgT_" + IntegerToString(rec.objId), lastT, curH,  rightT, mid,    c, c, true);
        DrawRect(OBJ_PREFIX + "fvgB_" + IntegerToString(rec.objId), lastT, mid,   rightT, last2L, c, c, true);
        int n = ArraySize(g_fvgs);
        ArrayResize(g_fvgs, n + 1);
        for(int i = n; i > 0; i--) g_fvgs[i] = g_fvgs[i - 1];
        g_fvgs[0] = rec;
    }
}

//====================================================================
//  v1.12 — SMART SUPPORT / RESISTANCE + TRENDLINES
//  Ported from "Smarter SnR" (© hanabil, MPL-2.0)
//
//  Pine → MQL5 mapping notes:
//
//  * ta.pivothigh(P,P) / ta.pivotlow(P,P) → IsPivotHighRaw / IsPivotLowRaw,
//    checked once per closed bar at logical offset P (so the pivot is
//    confirmed exactly P bars after it printed, same as Pine).
//
//  * The original's "Fix Zigzag Pivot" block (hA / lA / f_AA / f_offset)
//    exists to repair the case where ta.pivothigh fires twice with no
//    pivotlow between them. Rather than replicate the valuewhen gymnastics,
//    this port does the equivalent directly: when two raw pivots of the
//    SAME type arrive back to back, it scans the bars strictly between
//    them and inserts the opposite extreme as a synthetic pivot. The
//    resulting S/R stream is identical — an always-alternating sequence.
//
//  * S1/S2/S3 and R1/R2/R3 are the 3 most recent entries of that stream
//    (configurable up to 8 here). Levels are normalised to _Digits, which
//    replaces the original's truncate()/mintick logic.
//
//  * Trendlines keep their own pivot period and source (close body vs
//    shadow). slope is stored per SECOND, matching the original's use of
//    xloc.bar_time, so the projection stays correct across weekend gaps.
//
//  * Everything below reads bars through H()/L()/C_()/T(), so it replays
//    correctly under g_scanShift during historical backfill.
//====================================================================

//---------------- source selectors for the trendline module ---------
double TLHigh(int off) { return (InpTLSource == TL_SHADOW) ? H(off) : C_(off); }
double TLLow (int off) { return (InpTLSource == TL_SHADOW) ? L(off) : C_(off); }

//---------------- raw pivot tests -----------------------------------
bool IsPivotHighRaw(int centerOff, int period) {
    double c = H(centerOff);
    if(c <= 0) return false;
    for(int i = 1; i <= period; i++) {
        if(H(centerOff + i) >= c) return false;
        if(H(centerOff - i) >= c) return false;
    }
    return true;
}

bool IsPivotLowRaw(int centerOff, int period) {
    double c = L(centerOff);
    if(c <= 0) return false;
    for(int i = 1; i <= period; i++) {
        if(L(centerOff + i) <= c) return false;
        if(L(centerOff - i) <= c) return false;
    }
    return true;
}

bool IsPivotHighTL(int centerOff, int period) {
    double c = TLHigh(centerOff);
    if(c <= 0) return false;
    for(int i = 1; i <= period; i++) {
        if(TLHigh(centerOff + i) >= c) return false;
        if(TLHigh(centerOff - i) >= c) return false;
    }
    return true;
}

bool IsPivotLowTL(int centerOff, int period) {
    double c = TLLow(centerOff);
    if(c <= 0) return false;
    for(int i = 1; i <= period; i++) {
        if(TLLow(centerOff + i) <= c) return false;
        if(TLLow(centerOff - i) <= c) return false;
    }
    return true;
}

//---------------- level + zigzag storage ----------------------------
void PushSnR(SnRLevel &arr[], double price, datetime t) {
    int n = ArraySize(arr);
    if(n < SNR_MAX_LEVELS) { ArrayResize(arr, n + 1); n++; }
    for(int i = n - 1; i > 0; i--) arr[i] = arr[i - 1];
    arr[0].price = NormalizeDouble(price, _Digits);
    arr[0].time  = t;
}

void PushZigZag(double price, datetime t, int type) {
    if(!InpShowZigZag) return;
    if(g_zzSegments >= ZZ_MAX_SEGMENTS) return;

    int n = ArraySize(g_zz);
    ArrayResize(g_zz, n + 1);
    g_zz[n].price = price;
    g_zz[n].time  = t;
    g_zz[n].type  = type;

    if(n >= 1) {
        g_zzSegments++;
        string nm = OBJ_PREFIX + "zz_" + IntegerToString(g_zzSegments);
        DrawTrend(nm, g_zz[n - 1].time, g_zz[n - 1].price, t, price,
                  InpZigZagColor, STYLE_SOLID, 1, false);
    }
}

//---------------- S/R engine ----------------------------------------
// Scan strictly between two same-type pivots for the opposite extreme.
// Returns the logical offset of the extreme bar, or -1 if the gap is empty.
int FindExtremeBetween(int newerOff, int olderOff, bool wantHigh, double &outVal) {
    if(olderOff - 1 < newerOff + 1) return -1;   // nothing strictly between

    int bestOff = -1;
    double best = wantHigh ? -DBL_MAX : DBL_MAX;

    for(int off = olderOff - 1; off >= newerOff + 1; off--) {
        double v = wantHigh ? H(off) : L(off);
        if(v <= 0) continue;
        if(wantHigh) { if(v > best) { best = v; bestOff = off; } }
        else         { if(v < best) { best = v; bestOff = off; } }
    }
    if(bestOff < 0) return -1;
    outVal = best;
    return bestOff;
}

void UpdateSnRPivots() {
    int P = MathMax(1, InpSnRPeriod);

    bool isPH = IsPivotHighRaw(P, P);
    bool isPL = IsPivotLowRaw (P, P);

    // A bar can theoretically satisfy neither or (pathologically) both.
    // Both is meaningless for an alternating zigzag, so ignore it.
    if(isPH == isPL) return;

    if(isPH) {
        // Two highs in a row → insert the synthetic low that Pine's lA branch builds.
        if(g_lastRawType == +1 && g_lastRawTime > 0) {
            int prevOff = OffsetOfTime(g_lastRawTime);
            if(prevOff > P) {
                double lo = 0.0;
                int loOff = FindExtremeBetween(P, prevOff, false, lo);
                if(loOff >= 0) {
                    PushSnR(g_sup, lo, T(loOff));
                    PushZigZag(lo, T(loOff), -1);
                }
            }
        }
        PushSnR(g_res, H(P), T(P));
        PushZigZag(H(P), T(P), +1);
        g_lastRawType = +1;
        g_lastRawTime = T(P);
    }
    else {
        // Two lows in a row → insert the synthetic high (Pine's hA branch).
        if(g_lastRawType == -1 && g_lastRawTime > 0) {
            int prevOff = OffsetOfTime(g_lastRawTime);
            if(prevOff > P) {
                double hi = 0.0;
                int hiOff = FindExtremeBetween(P, prevOff, true, hi);
                if(hiOff >= 0) {
                    PushSnR(g_res, hi, T(hiOff));
                    PushZigZag(hi, T(hiOff), +1);
                }
            }
        }
        PushSnR(g_sup, L(P), T(P));
        PushZigZag(L(P), T(P), -1);
        g_lastRawType = -1;
        g_lastRawTime = T(P);
    }
}

//---------------- trendline engine ----------------------------------
double TLValueAt(TLine &tl, datetime t) {
    if(!tl.valid) return 0.0;
    return tl.p2 + (double)((long)t - (long)tl.t2) * tl.slope;
}

void DrawTLBreakMarker(bool up) {
    if(!InpTLBreakMarkers) return;

    string nm;
    if(InpTLNewestBreakOnly) {
        nm = OBJ_PREFIX + (up ? "tlBrkUp" : "tlBrkDn");
    } else {
        g_tlBreakCounter++;
        nm = OBJ_PREFIX + (up ? "tlBrkUp_" : "tlBrkDn_") + IntegerToString(g_tlBreakCounter);
    }

    if(up) DrawArrow(nm, T(0), L(0), 233, ResolveResist(),  ANCHOR_TOP);
    else   DrawArrow(nm, T(0), H(0), 234, ResolveSupport(), ANCHOR_BOTTOM);
}

void UpdateTrendlines() {
    int P = MathMax(1, InpTLPeriod);

    // Snapshot the PREVIOUS bar's trendline values before any update this bar.
    // This is what Pine reads as upperTl[1] / lowerTl[1].
    double prevUpVal = g_prevUpVal;  bool hadUpPrev = g_hadUpPrev;
    double prevLoVal = g_prevLoVal;  bool hadLoPrev = g_hadLoPrev;

    //---- upper trendline: forms on a LOWER pivot high (descending highs)
    if(IsPivotHighTL(P, P)) {
        g_tlPhVal1  = g_tlPhVal;   g_tlPhTime1 = g_tlPhTime;
        g_tlPhVal   = TLHigh(P);   g_tlPhTime  = T(P);

        if(g_tlPhTime1 > 0 && g_tlPhVal < g_tlPhVal1) {
            g_upperTL.valid = true;
            g_upperTL.t1 = g_tlPhTime1;  g_upperTL.p1 = g_tlPhVal1;
            g_upperTL.t2 = g_tlPhTime;   g_upperTL.p2 = g_tlPhVal;
            double dt = (double)((long)g_upperTL.t2 - (long)g_upperTL.t1);
            g_upperTL.slope = (dt != 0.0) ? (g_upperTL.p2 - g_upperTL.p1) / dt : 0.0;
        }
    }

    //---- lower trendline: forms on a HIGHER pivot low (ascending lows)
    if(IsPivotLowTL(P, P)) {
        g_tlPlVal1  = g_tlPlVal;   g_tlPlTime1 = g_tlPlTime;
        g_tlPlVal   = TLLow(P);    g_tlPlTime  = T(P);

        if(g_tlPlTime1 > 0 && g_tlPlVal > g_tlPlVal1) {
            g_lowerTL.valid = true;
            g_lowerTL.t1 = g_tlPlTime1;  g_lowerTL.p1 = g_tlPlVal1;
            g_lowerTL.t2 = g_tlPlTime;   g_lowerTL.p2 = g_tlPlVal;
            double dt = (double)((long)g_lowerTL.t2 - (long)g_lowerTL.t1);
            g_lowerTL.slope = (dt != 0.0) ? (g_lowerTL.p2 - g_lowerTL.p1) / dt : 0.0;
        }
    }

    //---- break detection (Pine: srcH[1] < upperTl[1] and srcH > upperTl)
    if(g_upperTL.valid && hadUpPrev) {
        double nowVal = TLValueAt(g_upperTL, T(0));
        if(TLHigh(1) < prevUpVal && TLHigh(0) > nowVal) {
            g_alerts.tlBreakUp = true;
            DrawTLBreakMarker(true);
        }
    }
    if(g_lowerTL.valid && hadLoPrev) {
        double nowVal = TLValueAt(g_lowerTL, T(0));
        if(TLLow(1) > prevLoVal && TLLow(0) < nowVal) {
            g_alerts.tlBreakDown = true;
            DrawTLBreakMarker(false);
        }
    }

    //---- carry this bar's values forward as next bar's [1]
    g_prevUpVal = g_upperTL.valid ? TLValueAt(g_upperTL, T(0)) : 0.0;
    g_hadUpPrev = g_upperTL.valid;
    g_prevLoVal = g_lowerTL.valid ? TLValueAt(g_lowerTL, T(0)) : 0.0;
    g_hadLoPrev = g_lowerTL.valid;
}

