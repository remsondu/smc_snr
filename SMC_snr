//===================== HISTORICAL BACKFILL ==========================
// Replay pivot detection, structure breaks, OB tracking, FVG detection,
// trailing extremes AND (v1.12) the S/R + trendline engines over the most
// recent N closed bars so all historical structures show up immediately.
void BackfillHistory() {
    int totalBars = Bars(_Symbol, _Period);

    // v1.12: the S/R and TL pivot tests need 2×period bars of headroom on
    // top of whatever the swing engine wants, so reserve for the largest.
    int lookbackNeed = MathMax(InpSwingsLength,
                               2 * MathMax(InpSnRPeriod, InpTLPeriod) + 5);
    int scanBars = MathMin(InpBackfillBars, totalBars - lookbackNeed - 50);

    if(scanBars < lookbackNeed * 2 + 50) {
        PrintFormat("[SMC] Backfill skipped — not enough history (%d bars available)", totalBars);
        return;
    }

    PrintFormat("[SMC] Backfilling %d historical bars...", scanBars);
    uint t0 = GetTickCount();

    for(int k = scanBars; k >= 1; k--) {
        g_scanShift = k - 1;

        ResetAlerts();            // suppress per-bar flags during scan
        UpdateCumTR();

        // Pivot capture (same calls as OnTick)
        GetCurrentStructure(InpSwingsLength, false, false);   // swing
        GetCurrentStructure(5,                false, true);    // internal
        if(InpShowEQHEQL)
            GetCurrentStructure(InpEQHEQLLength, true, false); // equal

        if(InpShowFVG) {
            DeleteFairValueGaps();
            DrawFairValueGaps();
        }

        if(InpShowInternals || InpShowInternalOBs)
            DisplayStructure(true);
        if(InpShowStructure || InpShowSwingOBs || InpShowHighLowSwings)
            DisplayStructure(false);

        if(InpShowInternalOBs) DeleteOrderBlocks(true);
        if(InpShowSwingOBs)    DeleteOrderBlocks(false);

        if(InpShowHighLowSwings || InpShowPDZones)
            UpdateTrailingExtremes();

        // v1.12 — S/R + trendline state (draws zigzag + break arrows inline).
        UpdateSmartSnR();
    }

    g_scanShift   = 0;
    g_lastBarTime = iTime(_Symbol, _Period, 0);  // prevent OnTick reprocessing the latest bar
    ResetAlerts();

    PrintFormat("[SMC] Backfill done in %u ms — %d swing OBs, %d internal OBs, %d FVGs, %d R / %d S levels, TL up=%s lo=%s",
                GetTickCount() - t0,
                ArraySize(g_swingOBs), ArraySize(g_internalOBs), ArraySize(g_fvgs),
                ArraySize(g_res), ArraySize(g_sup),
                g_upperTL.valid ? "yes" : "no", g_lowerTL.valid ? "yes" : "no");
}

//====================================================================
//  MULTI-TIMEFRAME SnR + TRENDLINE PUSH NOTIFIER
//
//  Included HERE (not at the top) because MQL5 requires declaration
//  before use at global scope: the module reuses InpSnRPeriod,
//  InpTLPeriod, InpTLSource and the ENUM_TL_SOURCE enum, all declared
//  above this point. It is fully self-contained otherwise — it reads
//  raw rates per timeframe, keeps its own state, and draws nothing.
//====================================================================
#include "SMC_SnR_TL_Notifier.mqh"

//===================== ONINIT / ONDEINIT ============================
int OnInit() {
    g_atrHandle   = iATR(_Symbol, _Period, 200);
    g_atr14Handle = iATR(_Symbol, _Period, 14);
    if(g_atrHandle == INVALID_HANDLE || g_atr14Handle == INVALID_HANDLE) {
        Print("[SMC] ATR handle creation failed");
        return INIT_FAILED;
    }

    InitPivot(g_swingHigh);    InitPivot(g_swingLow);
    InitPivot(g_internalHigh); InitPivot(g_internalLow);
    InitPivot(g_equalHigh);    InitPivot(g_equalLow);
    g_swingTrend.bias    = NEUTRAL;
    g_internalTrend.bias = NEUTRAL;

    g_trailing.top            = -DBL_MAX;
    g_trailing.bottom         = DBL_MAX;
    g_trailing.barTime        = 0;
    g_trailing.lastTopTime    = 0;
    g_trailing.lastBottomTime = 0;

    g_swingLeg = 0; g_swingLegPrev = 0;
    g_internalLeg = 0; g_internalLegPrev = 0;
    g_equalLeg = 0; g_equalLegPrev = 0;

    g_cumTR = 0.0; g_processedBars = 0;
    g_lastBarTime = 0;
    g_initialTime = 0;
    g_scanShift = 0;
    ResetAlerts();

    ArrayResize(g_swingOBs, 0);
    ArrayResize(g_internalOBs, 0);
    ArrayResize(g_fvgs, 0);

    //---- v1.12 state reset ----
    ArrayResize(g_res, 0);
    ArrayResize(g_sup, 0);
    ArrayResize(g_zz,  0);
    g_zzSegments  = 0;
    g_lastRawType = 0;
    g_lastRawTime = 0;

    g_tlPhVal = 0.0; g_tlPhVal1 = 0.0; g_tlPhTime = 0; g_tlPhTime1 = 0;
    g_tlPlVal = 0.0; g_tlPlVal1 = 0.0; g_tlPlTime = 0; g_tlPlTime1 = 0;

    ZeroMemory(g_upperTL);
    ZeroMemory(g_lowerTL);
    g_prevUpVal = 0.0; g_prevLoVal = 0.0;
    g_hadUpPrev = false; g_hadLoPrev = false;
    g_tlBreakCounter = 0;

    if(InpSnRPeriod < 1 || InpTLPeriod < 1) {
        Print("[SMC] S/R and trendline periods must be >= 1");
        return INIT_PARAMETERS_INCORRECT;
    }

    // ATR buffer needs a moment to populate after handle creation.
    if(InpBackfillOnInit) {
        int waitMs = 0;
        double atrCheck[];
        while(waitMs < 3000) {
            if(CopyBuffer(g_atrHandle, 0, 1, 1, atrCheck) >= 1) break;
            Sleep(50);
            waitMs += 50;
        }
        BackfillHistory();

        // Final draw passes: now that g_scanShift == 0, the right edges
        // anchor to the live "now" instead of to historical scan positions.
        if(InpShowInternalOBs)   DrawOrderBlocks(true);
        if(InpShowSwingOBs)      DrawOrderBlocks(false);
        if(InpShowHighLowSwings) DrawHighLowSwings();
        if(InpShowPDZones)       DrawPremiumDiscountZones();
        if(InpShowDaily)   DrawMTFLevels(PERIOD_D1, "D", InpDailyStyle,   InpDailyColor);
        if(InpShowWeekly)  DrawMTFLevels(PERIOD_W1, "W", InpWeeklyStyle,  InpWeeklyColor);
        if(InpShowMonthly) DrawMTFLevels(PERIOD_MN1,"M", InpMonthlyStyle, InpMonthlyColor);
        DrawSmartSnRAll();   // v1.12
        ChartRedraw();
    }

    EventSetTimer(15);
    if(!STL_Init()) Print("[SMC] MTF SnR/TL notifier failed to initialise — continuing without it");
    Print("[SMC] EA initialized on ", _Symbol, " ", EnumToString(_Period));
    return INIT_SUCCEEDED;
}

void OnDeinit(const int reason) {
    EventKillTimer();
    STL_Deinit();
    if(g_atrHandle   != INVALID_HANDLE) IndicatorRelease(g_atrHandle);
    if(g_atr14Handle != INVALID_HANDLE) IndicatorRelease(g_atr14Handle);
    DeleteByPrefix(OBJ_PREFIX);
    ChartRedraw();
}

//===================== ONTIMER ======================================
void OnTimer() {
    // Lightweight cleanup pass — re-run mitigation in case ticks were missed
    if(InpShowInternalOBs) DeleteOrderBlocks(true);
    if(InpShowSwingOBs)    DeleteOrderBlocks(false);
    if(InpShowFVG)         DeleteFairValueGaps();

    // v1.12 — keep the projected trendline price / dashboard live between bars.
    if(InpShowTrendlines || InpShowDashboard) {
        DrawTrendlinesOnChart();
        DrawSnRDashboard();
        ChartRedraw();
    }

    // v1.13 — higher timeframes print bars on their own schedule, not the
    // chart's, so poll the notifier here too or an H4 level could go stale
    // for hours. Each TF slot self-gates on its own new bar.
    STL_Update();
}

//===================== ONTICK =======================================
void OnTick() {
    bool newBar = IsNewBar();
    if(!newBar && !InpProcessOnTick) return;

    // Warm-up guard — v1.12 also accounts for the S/R and TL pivot windows.
    int warmup = MathMax(250, MathMax(InpSwingsLength + 50,
                                      2 * MathMax(InpSnRPeriod, InpTLPeriod) + 10));
    if(Bars(_Symbol, _Period) < warmup) return;

    if(g_initialTime == 0) g_initialTime = T(0);

    ResetAlerts();
    UpdateCumTR();

    // Pivot capture
    GetCurrentStructure(InpSwingsLength, false, false);          // swing
    GetCurrentStructure(5,                false, true);           // internal
    if(InpShowEQHEQL)
        GetCurrentStructure(InpEQHEQLLength, true, false);        // equal

    // FVG (delete first, then draw fresh)
    if(InpShowFVG) DeleteFairValueGaps();

    // Structure breaks
    if(InpShowInternals || InpShowInternalOBs)
        DisplayStructure(true);
    if(InpShowStructure || InpShowSwingOBs || InpShowHighLowSwings)
        DisplayStructure(false);

    // OB mitigation
    if(InpShowInternalOBs) DeleteOrderBlocks(true);
    if(InpShowSwingOBs)    DeleteOrderBlocks(false);

    // Draw OBs (fresh each bar for last N)
    if(InpShowInternalOBs) DrawOrderBlocks(true);
    if(InpShowSwingOBs)    DrawOrderBlocks(false);

    // FVG draw
    if(InpShowFVG) DrawFairValueGaps();

    // Trailing extremes + zones
    if(InpShowHighLowSwings || InpShowPDZones) {
        UpdateTrailingExtremes();
        if(InpShowHighLowSwings) DrawHighLowSwings();
        if(InpShowPDZones)       DrawPremiumDiscountZones();
    }

    // v1.12 — Smart S/R + trendlines (chart-TF state, then draw)
    UpdateSmartSnR();
    DrawSmartSnRAll();

    // v1.13 — MTF SnR/TL push notifier (chart TF caught here; higher TFs
    // are also polled from OnTimer).
    STL_Update();

    // MTF levels
    if(InpShowDaily)   DrawMTFLevels(PERIOD_D1, "D", InpDailyStyle,   InpDailyColor);
    if(InpShowWeekly)  DrawMTFLevels(PERIOD_W1, "W", InpWeeklyStyle,  InpWeeklyColor);
    if(InpShowMonthly) DrawMTFLevels(PERIOD_MN1,"M", InpMonthlyStyle, InpMonthlyColor);

    ChartRedraw();
}

