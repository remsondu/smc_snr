void DrawEqualHighLow(Pivot &p, double level, int size, bool isHigh) {
    color c = isHigh ? ResolveSwingBear() : ResolveSwingBull();
    string tag = isHigh ? "EQH" : "EQL";

    if(InpMode == SMC_PRESENT) {
        long lastObj = isHigh ? g_lastEqualHighObj : g_lastEqualLowObj;
        SafeDelete(OBJ_PREFIX + "eqline_" + IntegerToString(lastObj));
        SafeDelete(OBJ_PREFIX + "eqtxt_"  + IntegerToString(lastObj));
    }

    g_objCounter++;
    long id = g_objCounter;
    if(isHigh) g_lastEqualHighObj = id;
    else       g_lastEqualLowObj  = id;

    string lineName = OBJ_PREFIX + "eqline_" + IntegerToString(id);
    string textName = OBJ_PREFIX + "eqtxt_"  + IntegerToString(id);

    DrawTrend(lineName, p.barTime, p.currentLevel, T(size), level, c, STYLE_DOT, 1, false);

    datetime midT = (datetime)((long)p.barTime / 2 + (long)T(size) / 2);
    DrawText(textName, midT, level, tag, c, LabelFontSize(InpEQHEQLSize),
             isHigh ? ANCHOR_LOWER : ANCHOR_UPPER);
}

void GetCurrentStructure(int size, bool equalMode, bool internalMode) {
    int prevLeg = 0, curLeg = 0;
    if(equalMode)         { curLeg = g_equalLeg;    prevLeg = g_equalLegPrev;   }
    else if(internalMode) { curLeg = g_internalLeg; prevLeg = g_internalLegPrev;}
    else                  { curLeg = g_swingLeg;    prevLeg = g_swingLegPrev;   }

    LegFunc(size, prevLeg, curLeg);

    if(equalMode)         { g_equalLeg    = curLeg; g_equalLegPrev    = prevLeg; }
    else if(internalMode) { g_internalLeg = curLeg; g_internalLegPrev = prevLeg; }
    else                  { g_swingLeg    = curLeg; g_swingLegPrev    = prevLeg; }

    bool newPivot     = (curLeg != prevLeg);
    if(!newPivot) return;

    bool pivotLow     = (curLeg == BULLISH_LEG);
    bool pivotHigh    = (curLeg == BEARISH_LEG);

    double atr = GetATR(size);

    if(pivotLow) {
        if(equalMode) {
            if(MathAbs(g_equalLow.currentLevel - L(size)) < InpEQHEQLThresh * atr && g_equalLow.currentLevel != 0.0) {
                DrawEqualHighLow(g_equalLow, L(size), size, false);
                g_alerts.equalLows = true;
            }
            g_equalLow.lastLevel    = g_equalLow.currentLevel;
            g_equalLow.currentLevel = L(size);
            g_equalLow.crossed      = false;
            g_equalLow.barTime      = T(size);
            g_equalLow.barShift     = size;
        }
        else if(internalMode) {
            g_internalLow.lastLevel    = g_internalLow.currentLevel;
            g_internalLow.currentLevel = L(size);
            g_internalLow.crossed      = false;
            g_internalLow.barTime      = T(size);
            g_internalLow.barShift     = size;
        }
        else {
            g_swingLow.lastLevel    = g_swingLow.currentLevel;
            g_swingLow.currentLevel = L(size);
            g_swingLow.crossed      = false;
            g_swingLow.barTime      = T(size);
            g_swingLow.barShift     = size;

            g_trailing.bottom         = g_swingLow.currentLevel;
            g_trailing.barTime        = g_swingLow.barTime;
            g_trailing.lastBottomTime = g_swingLow.barTime;

            if(InpShowSwingPoints) {
                string tag = g_swingLow.currentLevel < g_swingLow.lastLevel ? "LL" : "HL";
                DrawSwingPointLabel(T(size), L(size), tag, ResolveSwingBull(), true);
            }
        }
    }
    else if(pivotHigh) {
        if(equalMode) {
            if(MathAbs(g_equalHigh.currentLevel - H(size)) < InpEQHEQLThresh * atr && g_equalHigh.currentLevel != 0.0) {
                DrawEqualHighLow(g_equalHigh, H(size), size, true);
                g_alerts.equalHighs = true;
            }
            g_equalHigh.lastLevel    = g_equalHigh.currentLevel;
            g_equalHigh.currentLevel = H(size);
            g_equalHigh.crossed      = false;
            g_equalHigh.barTime      = T(size);
            g_equalHigh.barShift     = size;
        }
        else if(internalMode) {
            g_internalHigh.lastLevel    = g_internalHigh.currentLevel;
            g_internalHigh.currentLevel = H(size);
            g_internalHigh.crossed      = false;
            g_internalHigh.barTime      = T(size);
            g_internalHigh.barShift     = size;
        }
        else {
            g_swingHigh.lastLevel    = g_swingHigh.currentLevel;
            g_swingHigh.currentLevel = H(size);
            g_swingHigh.crossed      = false;
            g_swingHigh.barTime      = T(size);
            g_swingHigh.barShift     = size;

            g_trailing.top         = g_swingHigh.currentLevel;
            g_trailing.barTime     = g_swingHigh.barTime;
            g_trailing.lastTopTime = g_swingHigh.barTime;

            if(InpShowSwingPoints) {
                string tag = g_swingHigh.currentLevel > g_swingHigh.lastLevel ? "HH" : "LH";
                DrawSwingPointLabel(T(size), H(size), tag, ResolveSwingBear(), false);
            }
        }
    }
}

