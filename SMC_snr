//===================== UTILITY: BAR ACCESS ==========================
// Logical offset 0 = most recent CLOSED bar (shift 1 in MQL5).
double H(int off)         { return iHigh (_Symbol, _Period, off + 1 + g_scanShift); }
double L(int off)         { return iLow  (_Symbol, _Period, off + 1 + g_scanShift); }
double C_(int off)        { return iClose(_Symbol, _Period, off + 1 + g_scanShift); }
double O_(int off)        { return iOpen (_Symbol, _Period, off + 1 + g_scanShift); }
datetime T(int off)       { return iTime (_Symbol, _Period, off + 1 + g_scanShift); }

// Convert a bar time back into a logical offset in the current scan frame.
int OffsetOfTime(datetime t) {
    if(t == 0) return -1;
    int sh = iBarShift(_Symbol, _Period, t, false);
    if(sh < 0) return -1;
    return sh - 1 - g_scanShift;
}

double Highest(int size) {
    int idx = iHighest(_Symbol, _Period, MODE_HIGH, size, 1 + g_scanShift);
    if(idx < 0) return -DBL_MAX;
    return iHigh(_Symbol, _Period, idx);
}
double Lowest(int size) {
    int idx = iLowest(_Symbol, _Period, MODE_LOW, size, 1 + g_scanShift);
    if(idx < 0) return DBL_MAX;
    return iLow(_Symbol, _Period, idx);
}

double GetATR(int off) {
    if(g_atrHandle == INVALID_HANDLE) return 0;
    double buf[];
    if(CopyBuffer(g_atrHandle, 0, off + 1 + g_scanShift, 1, buf) < 1) return 0;
    return buf[0];
}
double GetATR14(int off) {
    if(g_atr14Handle == INVALID_HANDLE) return 0;
    double buf[];
    if(CopyBuffer(g_atr14Handle, 0, off + 1 + g_scanShift, 1, buf) < 1) return 0;
    return buf[0];
}
double GetVolatility(int off) {
    if(InpOBFilter == SMC_ATR) return GetATR(off);
    return g_processedBars > 0 ? g_cumTR / g_processedBars : 0;
}

double GetParsedHigh(int off) {
    double v = GetVolatility(off);
    double h = H(off), l = L(off);
    return (h - l) >= 2.0 * v ? l : h;
}
double GetParsedLow(int off) {
    double v = GetVolatility(off);
    double h = H(off), l = L(off);
    return (h - l) >= 2.0 * v ? h : l;
}

void UpdateCumTR() {
    double tr = MathMax(H(0), C_(1)) - MathMin(L(0), C_(1));
    g_cumTR += tr;
    g_processedBars++;
}

bool IsNewBar() {
    datetime t = iTime(_Symbol, _Period, 0);
    if(t == 0) return false;
    if(t != g_lastBarTime) {
        g_lastBarTime = t;
        return true;
    }
    return false;
}

//===================== UTILITY: OBJECT DRAWING ======================
void DrawHline(string name, double price, color c, ENUM_LINE_STYLE st = STYLE_SOLID, int width = 1) {
    if(ObjectFind(0, name) < 0) ObjectCreate(0, name, OBJ_HLINE, 0, 0, price);
    ObjectSetDouble (0, name, OBJPROP_PRICE,  price);
    ObjectSetInteger(0, name, OBJPROP_COLOR,  c);
    ObjectSetInteger(0, name, OBJPROP_STYLE,  st);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,  width);
    ObjectSetInteger(0, name, OBJPROP_BACK,   true);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
}

void DrawTrend(string name, datetime t1, double p1, datetime t2, double p2,
               color c, ENUM_LINE_STYLE st = STYLE_SOLID, int width = 1, bool ray = false) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_TREND, 0, t1, p1, t2, p2);
    ObjectMove(0, name, 0, t1, p1);
    ObjectMove(0, name, 1, t2, p2);
    ObjectSetInteger(0, name, OBJPROP_COLOR,         c);
    ObjectSetInteger(0, name, OBJPROP_STYLE,         st);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,         width);
    ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT,     ray);
    ObjectSetInteger(0, name, OBJPROP_RAY_LEFT,      false);
    ObjectSetInteger(0, name, OBJPROP_BACK,          false);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE,    false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,        true);
}

// NOTE (v1.11 fix): OBJ_RECTANGLE in MT5 uses OBJPROP_COLOR for both outline AND fill
// when OBJPROP_FILL=true. OBJPROP_BGCOLOR is silently ignored on OBJ_RECTANGLE.
void DrawRect(string name, datetime t1, double p1, datetime t2, double p2,
              color border, color fill, bool back = true) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2);
    ObjectMove(0, name, 0, t1, p1);
    ObjectMove(0, name, 1, t2, p2);
    color drawColor = (border == CLR_NONE) ? fill : border;
    ObjectSetInteger(0, name, OBJPROP_COLOR,      drawColor);
    ObjectSetInteger(0, name, OBJPROP_BGCOLOR,    fill);   // kept for API symmetry
    ObjectSetInteger(0, name, OBJPROP_FILL,       true);
    ObjectSetInteger(0, name, OBJPROP_BACK,       back);
    ObjectSetInteger(0, name, OBJPROP_STYLE,      STYLE_SOLID);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,      1);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,     true);
}

void DrawText(string name, datetime t, double p, string txt, color c, int fontSize = 8,
              ENUM_ANCHOR_POINT anchor = ANCHOR_CENTER) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_TEXT, 0, t, p);
    ObjectMove(0, name, 0, t, p);
    ObjectSetString (0, name, OBJPROP_TEXT,    txt);
    ObjectSetInteger(0, name, OBJPROP_COLOR,   c);
    ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fontSize);
    ObjectSetString (0, name, OBJPROP_FONT,    "Arial");
    ObjectSetInteger(0, name, OBJPROP_ANCHOR,  anchor);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,  true);
}

// v1.12 — Wingdings arrow marker (used for trendline breaks).
// NOTE: OBJ_ARROW anchors use ENUM_ARROW_ANCHOR (only ANCHOR_TOP / ANCHOR_BOTTOM),
// which is a DIFFERENT enum from the ENUM_ANCHOR_POINT used by OBJ_TEXT / OBJ_LABEL.
// Typing this parameter as ENUM_ANCHOR_POINT is a compile error in MQL5.
void DrawArrow(string name, datetime t, double p, int code, color c, ENUM_ARROW_ANCHOR anchor) {
    if(ObjectFind(0, name) < 0)
        ObjectCreate(0, name, OBJ_ARROW, 0, t, p);
    ObjectMove(0, name, 0, t, p);
    ObjectSetInteger(0, name, OBJPROP_ARROWCODE,  code);
    ObjectSetInteger(0, name, OBJPROP_COLOR,      c);
    ObjectSetInteger(0, name, OBJPROP_WIDTH,      1);
    ObjectSetInteger(0, name, OBJPROP_ANCHOR,     anchor);
    ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
    ObjectSetInteger(0, name, OBJPROP_HIDDEN,     true);
}

void SafeDelete(string name) {
    if(ObjectFind(0, name) >= 0) ObjectDelete(0, name);
}

void DeleteByPrefix(string prefix) {
    int total = ObjectsTotal(0, -1, -1);
    for(int i = total - 1; i >= 0; i--) {
        string n = ObjectName(0, i, -1, -1);
        if(StringFind(n, prefix) == 0) ObjectDelete(0, n);
    }
}

//===================== PIVOT INIT ===================================
void InitPivot(Pivot &p) {
    p.currentLevel = 0.0;
    p.lastLevel    = 0.0;
    p.crossed      = false;
    p.barTime      = 0;
    p.barShift     = 0;
}

//===================== LEG DETECTION ================================
int LegFunc(int size, int &prevLegOut, int &currentLegInOut) {
    double pivotHigh = H(size);
    double pivotLow  = L(size);
    double recentHi  = Highest(size);
    double recentLo  = Lowest(size);

    prevLegOut = currentLegInOut;
    if(pivotHigh > recentHi)      currentLegInOut = BEARISH_LEG;
    else if(pivotLow < recentLo)  currentLegInOut = BULLISH_LEG;
    return currentLegInOut;
}

